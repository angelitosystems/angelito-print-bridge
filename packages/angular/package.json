{
  "name": "@angelitosystems/print-bridge-angular",
  "version": "0.1.0",
  "description": "Integración Angular (providers, servicios y signals) de Angelito Print Bridge, creado por Angelito Systems S.A.C.",
  "license": "Apache-2.0",
  "author": {
    "name": "Angelito Systems S.A.C.",
    "url": "https://angelitosystems.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelitosystems/angelito-print-bridge.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/angelitosystems/angelito-print-bridge/tree/main/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/angelitosystems/angelito-print-bridge/issues"
  },
  "keywords": [
    "printing",
    "angular",
    "signals",
    "print-bridge",
    "angelito-systems"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node -e \"for (const f of ['LICENSE','NOTICE']) require('fs').copyFileSync('../../'+f, 'dist/'+f)\"",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "tsc -p tsconfig.lib.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "publish:dist": "npm publish ./dist"
  },
  "peerDependencies": {
    "@angelitosystems/print-bridge": "^0.4.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "devDependencies": {
    "@angelitosystems/print-bridge": "*",
    "@angelitosystems/print-bridge-shared-testing": "*",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
