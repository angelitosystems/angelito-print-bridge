{
  "name": "@angelitosystems/print-bridge-react",
  "version": "0.1.0",
  "description": "Integración React (provider y hooks) de Angelito Print Bridge, creado por Angelito Systems S.A.C.",
  "license": "Apache-2.0",
  "author": {
    "name": "Angelito Systems S.A.C.",
    "url": "https://angelitosystems.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelitosystems/angelito-print-bridge.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/angelitosystems/angelito-print-bridge/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/angelitosystems/angelito-print-bridge/issues"
  },
  "keywords": ["printing", "react", "hooks", "nextjs", "print-bridge", "angelito-systems"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "prepack": "node -e \"for (const f of ['LICENSE','NOTICE']) require('fs').copyFileSync('../../'+f, f)\" && npm run build"
  },
  "peerDependencies": {
    "@angelitosystems/print-bridge": "^0.4.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@angelitosystems/print-bridge": "*",
    "@angelitosystems/print-bridge-shared-testing": "*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
