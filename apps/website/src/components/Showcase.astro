---
// Copyright 2026 Angelito Systems S.A.C. · SPDX-License-Identifier: Apache-2.0
// Frameworks and examples listing (kind="frameworks" | "examples"), linked to real docs and repository folders.
import { href, type Lang } from "../lib/i18n";
interface Props { lang: Lang; kind: "frameworks" | "examples" }
const { lang, kind } = Astro.props;
const es = lang === "es";
const repo = "https://github.com/angelitosystems/angelito-print-bridge/tree/main/";
const frameworks = [
  { name: "JavaScript / TypeScript", pkg: "@angelitosystems/print-bridge", doc: "javascript/sdk/", api: "createPrintBridge · createPrintBridgeStore · escpos" },
  { name: "React + Vite", pkg: "@angelitosystems/print-bridge-react", doc: "react/", api: "PrintBridgeProvider · usePrinters · usePrint · usePrintJob" },
  { name: "Next.js (App Router)", pkg: "@angelitosystems/print-bridge-react", doc: "nextjs/", api: es ? "Mismo paquete React (\"use client\")" : "Same React package (\"use client\")" },
  { name: "Angular", pkg: "@angelitosystems/print-bridge-angular", doc: "angular/", api: "providePrintBridge · PrintBridgeService · PrinterService · PrintJobService" },
  { name: "Svelte / SvelteKit", pkg: "@angelitosystems/print-bridge-svelte", doc: "svelte/", api: "providePrintBridge · getPrintBridge" },
  { name: "Vue / Nuxt", pkg: "@angelitosystems/print-bridge-vue", doc: "vue/", api: "createPrintBridgePlugin · usePrintBridge · usePrinters · usePrint" },
];
const examples = [
  ["vanilla-typescript", "TypeScript + Vite"], ["react-vite", "React 19 + Vite"], ["nextjs", "Next.js 16 App Router"],
  ["angular", "Angular 22 (zoneless)"], ["sveltekit", "SvelteKit 3 + Svelte 5"], ["vue-vite", "Vue 3 + Vite"], ["nuxt", "Nuxt 4"],
];
---
<section class="mx-auto max-w-6xl px-4 py-16">
  {kind === "frameworks" ? (
    <>
      <h1 class="text-4xl font-bold">{es ? "Frameworks compatibles" : "Supported frameworks"}</h1>
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">{es
        ? "Todas las integraciones usan el mismo núcleo y comparten una sola conexión con el agente. Solo el SDK base (0.3.0) está publicado; las integraciones están en el repositorio y se publicarán en GitHub Packages tras su aprobación."
        : "Every integration uses the same core and shares a single agent connection. Only the base SDK (0.3.0) is published; the integrations are in the repository and will be published to GitHub Packages once approved."}</p>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {frameworks.map((f) => (
          <a class="card block p-6 transition hover:border-brand-500" href={href(lang, f.doc)}>
            <h2 class="text-lg font-semibold">{f.name}</h2>
            <p class="mt-1 font-mono text-xs text-slate-500">{f.pkg}</p>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{f.api}</p>
          </a>
        ))}
      </div>
    </>
  ) : (
    <>
      <h1 class="text-4xl font-bold">{es ? "Ejemplos" : "Examples"}</h1>
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">{es
        ? "Aplicaciones completas que compilan en la CI: detectan el agente, autorizan la aplicación, listan impresoras e imprimen un PDF de prueba."
        : "Complete apps that build in CI: they detect the agent, authorize the app, list printers and print a test PDF."}</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {examples.map(([dir, label]) => (
          <a class="card block p-6 transition hover:border-brand-500" href={`${repo}examples/${dir}`} rel="noopener">
            <h2 class="font-semibold">{label}</h2>
            <p class="mt-1 font-mono text-xs text-slate-500">examples/{dir}</p>
          </a>
        ))}
      </div>
      <p class="mt-8 text-sm"><a class="text-brand-600 hover:underline dark:text-brand-400" href={href(lang, "playground/")}>{es ? "Pruebe el laboratorio en el navegador →" : "Try the in-browser playground →"}</a></p>
    </>
  )}
</section>
