---
// Copyright 2026 Angelito Systems S.A.C. · SPDX-License-Identifier: Apache-2.0
import { latestAgentRelease } from "../lib/releases";
import type { Lang } from "../lib/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === "es";
const release = await latestAgentRelease();
const fmt = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const date = release ? new Date(release.publishedAt).toLocaleDateString(es ? "es-PE" : "en-US", { dateStyle: "long" }) : "";
const label = (kind: string) => (kind === "installer" ? (es ? "Instalador" : "Installer") : kind === "portable" ? (es ? "Portable (zip)" : "Portable (zip)") : (es ? "Sumas SHA-256" : "SHA-256 checksums"));
---
<section class="mx-auto max-w-5xl px-4 py-16">
  <h1 class="text-4xl font-bold">{es ? "Descargar Angelito Print Bridge" : "Download Angelito Print Bridge"}</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-300">
    {es ? "Agente local y app de bandeja para Windows 10 (2004+) y Windows 11. Datos obtenidos de GitHub Releases al publicar este sitio." : "Local agent and tray app for Windows 10 (2004+) and Windows 11. Data fetched from GitHub Releases when this site was published."}
  </p>

  {release ? (
    <div class="mt-10 space-y-6">
      <div class="card p-6">
        <h2 class="text-2xl font-semibold">{release.name}</h2>
        <p class="mt-1 text-sm text-slate-500">{es ? "Versión" : "Version"} {release.version} · {es ? "publicada el" : "published on"} {date}</p>
        <p class="mt-3 text-sm text-amber-700 dark:text-amber-300">
          {es ? "Los ejecutables aún no están firmados digitalmente: Windows SmartScreen puede mostrar una advertencia. ARM64 está compilado pero no validado en hardware ARM64." : "Executables are not code-signed yet: Windows SmartScreen may show a warning. ARM64 is built but not validated on ARM64 hardware."}
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead><tr class="border-b border-slate-200 dark:border-white/10">
            <th class="py-3 pr-4">{es ? "Archivo" : "File"}</th><th class="py-3 pr-4">{es ? "Tipo" : "Type"}</th><th class="py-3 pr-4">{es ? "Arquitectura" : "Architecture"}</th><th class="py-3 pr-4">{es ? "Tamaño" : "Size"}</th><th class="py-3">SHA-256</th>
          </tr></thead>
          <tbody>
            {release.assets.map((a) => (
              <tr class="border-b border-slate-100 align-top dark:border-white/5">
                <td class="py-3 pr-4"><a class="font-medium text-brand-600 hover:underline dark:text-brand-400" href={a.url}>{a.name}</a></td>
                <td class="py-3 pr-4">{label(a.kind)}</td>
                <td class="py-3 pr-4">{a.arch}</td>
                <td class="py-3 pr-4 whitespace-nowrap">{fmt(a.size)}</td>
                <td class="py-3 font-mono text-xs break-all">{a.sha256 ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm">
        <a class="text-brand-600 hover:underline dark:text-brand-400" href={release.url}>{es ? "Notas de la versión" : "Release notes"}</a> ·
        <a class="text-brand-600 hover:underline dark:text-brand-400" href="https://github.com/angelitosystems/angelito-print-bridge/releases">{es ? "Historial de versiones" : "Release history"}</a>
      </p>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {es ? "Verifique la descarga en PowerShell:" : "Verify the download in PowerShell:"} <code class="font-mono">Get-FileHash .\archivo.exe -Algorithm SHA256</code>
      </p>
    </div>
  ) : (
    <div class="card mt-10 p-6">
      <p>{es ? "La descarga está pendiente: todavía no hay un release estable del agente disponible." : "Download pending: there is no stable agent release available yet."}</p>
      <a class="mt-3 inline-block text-brand-600 hover:underline dark:text-brand-400" href="https://github.com/angelitosystems/angelito-print-bridge/releases">GitHub Releases</a>
    </div>
  )}
</section>
