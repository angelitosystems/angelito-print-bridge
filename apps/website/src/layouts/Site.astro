---
// Copyright 2026 Angelito Systems S.A.C. · SPDX-License-Identifier: Apache-2.0
import "../styles/site.css";
import { href, base, t, type Lang } from "../lib/i18n";

interface Props { lang: Lang; title: string; description: string; path: string; jsonLd?: object }
const { lang, title, description, path, jsonLd } = Astro.props;
const s = t[lang];
const canonical = new URL(href(lang, path), Astro.site).toString();
const alternate = (l: Lang) => new URL(href(l, path), Astro.site).toString();
const ogImage = new URL(`${base}images/logo.png`, Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternate("es")} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="x-default" href={alternate("es")} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "es" ? "es_PE" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light dark" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased dark:bg-ink-950 dark:text-slate-100">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white">
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-white/10 dark:bg-ink-950/80">
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3" aria-label={lang === "es" ? "Principal" : "Main"}>
        <a href={href(lang)} class="flex items-center gap-2 font-semibold">
          <img src={`${base}images/emblem.png`} alt="" width="32" height="32" class="rounded-md" />
          <span>Angelito Print Bridge</span>
        </a>
        <div class="ml-auto hidden items-center gap-5 text-sm md:flex">
          <a class="hover:text-brand-500" href={href(lang, "getting-started/introduction/")}>{s.nav.docs}</a>
          <a class="hover:text-brand-500" href={href(lang, "frameworks/")}>{s.nav.frameworks}</a>
          <a class="hover:text-brand-500" href={href(lang, "examples/")}>{s.nav.examples}</a>
          <a class="hover:text-brand-500" href={href(lang, "playground/")}>{s.nav.playground}</a>
          <a class="rounded-lg bg-brand-600 px-3 py-1.5 font-medium text-white hover:bg-brand-500" href={href(lang, "download/")}>{s.nav.download}</a>
        </div>
        <a class="ml-auto text-sm underline-offset-4 hover:underline md:ml-0" href={href(lang === "es" ? "en" : "es", path)} hreflang={lang === "es" ? "en" : "es"}>
          {lang === "es" ? "English" : "Español"}
        </a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-24 border-t border-slate-200 py-10 text-sm text-slate-600 dark:border-white/10 dark:text-slate-400">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 md:flex-row md:items-center md:justify-between">
        <p>© 2026 Angelito Systems S.A.C. · {s.footer}</p>
        <p class="flex gap-4">
          <a class="hover:text-brand-500" href="https://angelitosystems.net" rel="noopener">angelitosystems.net</a>
          <a class="hover:text-brand-500" href="https://github.com/angelitosystems/angelito-print-bridge" rel="noopener">GitHub</a>
          <a class="hover:text-brand-500" href="https://github.com/angelitosystems/angelito-print-bridge/blob/main/LICENSE" rel="noopener">Apache-2.0</a>
        </p>
      </div>
    </footer>
  </body>
</html>
