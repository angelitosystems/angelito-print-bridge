<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WindowsTfm>net10.0-windows10.0.19041.0</WindowsTfm>
    <Company>Angelito Systems S.A.C.</Company>
    <Product>Angelito Print Bridge</Product>
    <Copyright>Copyright © 2026 Angelito Systems S.A.C.</Copyright>
    <Authors>Angelito Systems S.A.C.</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://angelitosystems.net</PackageProjectUrl>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Restore for every published RID so locked-mode restore also works for dotnet publish -r. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>0.4.1</Version>
  </PropertyGroup>
</Project>
