<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Angelito.PrintBridge.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Icons: Material Design Icons (Pictogrammers), Apache-2.0. See THIRD-PARTY-NOTICES.md -->
      <StreamGeometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
      <StreamGeometry x:Key="IconPrinter">M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z</StreamGeometry>
      <StreamGeometry x:Key="IconList">M7,5H21V7H7V5M7,13V11H21V13H7M4,4.5A1.5,1.5 0 0,1 5.5,6A1.5,1.5 0 0,1 4,7.5A1.5,1.5 0 0,1 2.5,6A1.5,1.5 0 0,1 4,4.5M4,10.5A1.5,1.5 0 0,1 5.5,12A1.5,1.5 0 0,1 4,13.5A1.5,1.5 0 0,1 2.5,12A1.5,1.5 0 0,1 4,10.5M7,19V17H21V19H7M4,16.5A1.5,1.5 0 0,1 5.5,18A1.5,1.5 0 0,1 4,19.5A1.5,1.5 0 0,1 2.5,18A1.5,1.5 0 0,1 4,16.5Z</StreamGeometry>
      <StreamGeometry x:Key="IconShield">M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>

      <StreamGeometry x:Key="IconCert">M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BrandBrush" Color="#2453E0" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PageBrush" Color="#EEF2FA" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#DCE3F0" />
          <SolidColorBrush x:Key="MutedBrush" Color="#4F5A70" />
          <SolidColorBrush x:Key="OkBrush" Color="#0F8A4A" />
          <SolidColorBrush x:Key="WarnBrush" Color="#B3261E" />
          <SolidColorBrush x:Key="AttentionBrush" Color="#F1EDFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BrandBrush" Color="#8AB4FF" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#121A2E" />
          <SolidColorBrush x:Key="PageBrush" Color="#0A0F1E" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#24314F" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A3AECA" />
          <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FCA5A5" />
          <SolidColorBrush x:Key="AttentionBrush" Color="#221B45" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Accent and sidebar look the same in both themes (dark sidebar, blue→violet accent). -->
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="#7C3AED" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentTextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#3B82F6" />
        <GradientStop Offset="0.55" Color="#8B5CF6" />
        <GradientStop Offset="1" Color="#06B6D4" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NavGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#0B1226" />
        <GradientStop Offset="1" Color="#151E3F" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="NavTextBrush" Color="#C7D2EC" />
      <SolidColorBrush x:Key="NavMutedBrush" Color="#8C99BA" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 4 18 0 #12000000" />
    </Style>
    <Style Selector="Border.attention">
      <Setter Property="Background" Value="{DynamicResource AttentionBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentGradient}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.accentline">
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextGradient}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="TabControl.navless /template/ ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="Margin" Value="12,2" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
